<script>

    /* =========================
       PERSONALITY SLIDER
    ========================= */

    const slider =
        document.getElementById("personality");

    const personalityValue =
        document.getElementById("personalityValue");


    slider.addEventListener("input", function () {

        const value = Number(this.value);


        if (value < 20) {

            personalityValue.textContent =
                "Very direct";

        }

        else if (value < 40) {

            personalityValue.textContent =
                "Direct";

        }

        else if (value < 60) {

            personalityValue.textContent =
                "Balanced";

        }

        else if (value < 80) {

            personalityValue.textContent =
                "Friendly";

        }

        else {

            personalityValue.textContent =
                "Very friendly";

        }

    });



    /* =========================
       TEMPORARY CHAT
    ========================= */

    function sendMessage() {

        const input =
            document.getElementById("userInput");

        const messages =
            document.getElementById("messages");

        const text =
            input.value.trim();


        if (!text) {
            return;
        }


        /* USER MESSAGE */

        const userMessage =
            document.createElement("div");

        userMessage.className =
            "message user";

        userMessage.textContent =
            text;

        messages.appendChild(userMessage);


        input.value = "";


        /* TEMPORARY BOT RESPONSE */

        setTimeout(function () {

            const botMessage =
                document.createElement("div");

            botMessage.className =
                "message bot";

            botMessage.textContent =
                "Thanks for your question! Soon I'll be connected to the real AI. 🤖";

            messages.appendChild(botMessage);


            messages.scrollTop =
                messages.scrollHeight;

        }, 500);

    }

</script>


